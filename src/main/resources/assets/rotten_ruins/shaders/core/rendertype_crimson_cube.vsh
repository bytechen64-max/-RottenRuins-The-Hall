#version 150 core

// ══════════════════════════════════════════════════════════════════════════
//  绯红方块 · 体积光线步进（顶点阶段）
//
//  几何：Java 侧画的是一个**世界空间轴对齐包围盒** —— 但刻意只画它的
//  <b>背面</b>（cull FRONT），并且关掉深度测试与深度写入。这样做的原因是
//  把「每条视线只出一个片元」这件事变成几何保证：
//
//    · 只画背面 ⇒ 盒子朝向相机的那些面被剔除，视线穿过盒子时命中的
//      永远是**远侧**那个面，所以每个像素最多只产生一个片元；
//    · 关深度测试 ⇒ 这个片元不会被前面的地形深度直接干掉。遮挡判断
//      改由片元阶段采样 DepthTexture 自己做（这样被挡住的像素能
//      discard，而不是把整块效果丢掉）。
//
//  为什么这很重要：光线步进必须在**每条视线恰好一次**的时机执行。
//  如果正/反面都画，同一条视线会跑两次步进（近面和远面各一次），
//  效果会被叠加成两倍亮度、并且在盒子边缘出现明显的接缝。
//
//  这个顶点阶段本身不做任何事，只是把 Java 侧已经变换好的坐标透传：
//  Java 用 pose 矩阵把世界坐标变成了相机相对坐标，所以这里只乘 ProjMat。
// ══════════════════════════════════════════════════════════════════════════

in vec3 Position;
in vec4 Color;
in vec3 Normal;

uniform mat4 ProjMat;

out vec4 vertexColor;
out vec3 vPos;

void main() {
    gl_Position = ProjMat * vec4(Position, 1.0);
    vPos        = Position;   // 视图空间（Java 侧已用 pose 矩阵预变换）
    vertexColor = Color;
}
